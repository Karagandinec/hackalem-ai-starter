# ============================================================
# Скопируй этот файл в .env и подставь свой ключ:
#   cp .env.example .env        (Git Bash / macOS / Linux)
#   copy .env.example .env      (Windows cmd)
# .env в .gitignore и в репозиторий НЕ попадает.
# ============================================================

# --- OpenAI ---
# Без ключа проект всё равно работает: модуль ai/ уходит в заглушку-фолбэк.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Усилие рассуждения для gpt-5.x / gpt-6 / o-серии: none, low, medium, high.
# none — быстрее всего и работает с инструментами агента. Обычным моделям не передаётся.
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
# Рассуждение тратит тот же лимит, что и ответ: при усилии выше none держи запас.
OPENAI_MAX_OUTPUT_TOKENS=2000
# Кэш ответов модели: одинаковый запрос второй раз не тратит деньги.
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600

# --- Backend ---
APP_NAME=HackAlem Starter
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PORT=8000
# Налить демо-данные при старте, если база пуста. Нужно на бесплатном
# хостинге, где диск чистится при рестарте. Локально не нужно: есть make seed.
SEED_ON_START=false

# --- Frontend (Vite читает только переменные с префиксом VITE_) ---
VITE_API_URL=http://localhost:8000
